gamma = list(df = big_gamma, palette = "Blues")
)
# Determine global x-axis limits across all bands
all_values <- c(bands$mu$df$cols[6],
bands$beta$df$cols[6],
bands$gamma$df$cols[6])
x_min <- min(all_values, na.rm = TRUE)
x_max <- max(all_values, na.rm = TRUE)
# Function to make a ridgeline plot for a band
plot_ridgeline_band_shades <- function(df, palette_name = "Reds", col = "mean_recurrence_rate", y_name = "Value", band_name = "μ", x_limits = c(0,1)) {
df <- df %>%
mutate(
condicion = factor(condicion, levels = c("SE10", "SE5", "AM")),  # Row order
periodo = factor(periodo, levels = c("Reposo", "Actividad"))     # Overlay order
)
# Generate shades for conditions
cond_colors <- brewer.pal(9, palette_name)[c(7,5,3)]  # Dark → Light for SE10, SE5, AM
names(cond_colors) <- c("SE10", "SE5", "AM")
# Grey for Reposo
rest_color <- "grey91"
# Create a new fill column that combines condicion and periodo
df <- df %>%
mutate(
fill_color = ifelse(periodo == "Actividad", cond_colors[as.character(condicion)], rest_color)
)
ggplot(df, aes(x = .data[[col]], y = condicion, fill = fill_color)) +
geom_density_ridges(alpha = 0.7, scale = 1.5, color = "black", linewidth = 0.4) +
scale_fill_identity() +
labs(x = y_name, title = band_name) +
theme_classic(base_size = 10) +
theme(legend.position = "none", axis.title.y = element_blank(), , axis.title.x = element_blank()) +
xlim(x_limits[1], x_limits[2] + (x_limits[2] * 0.2))
}
column = cols[6]
plot_mu    <- plot_ridgeline_band_shades(bands$mu$df,    palette_name = bands$mu$palette,    col = column, y_name = "Recurrence Rate (μ)", band_name = "μ", x_limits = c(x_min, x_max))
plot_beta  <- plot_ridgeline_band_shades(bands$beta$df,  palette_name = bands$beta$palette,  col = column, y_name = "Recurrence Rate (β)", band_name = "β", x_limits = c(x_min, x_max))
plot_gamma <- plot_ridgeline_band_shades(bands$gamma$df, palette_name = bands$gamma$palette, col = column, y_name = "Recurrence Rate (γ)", band_name = "γ", x_limits = c(x_min, x_max))
combined_plot <- plot_mu / plot_beta / plot_gamma +
plot_annotation(
title = "DET",
theme = theme(
plot.title = element_text(size = 16, face = "bold", hjust = 0)  # hjust = 0 aligns left
)
)
# Show the plot
combined_plot
column = cols[6]
# Determine global x-axis limits across all bands
all_values <- c(bands$mu$df$column,
bands$beta$df$column,
bands$gamma$df$column)
x_min <- min(all_values, na.rm = TRUE)
x_max <- max(all_values, na.rm = TRUE)
