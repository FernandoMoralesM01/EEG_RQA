df_5 <- df_5 %>% filter(determinism != 0, Binaria > 0.5) %>%
select(-banda, -archivo, -sujeto, -sesion)
df_0 <- df_0 %>% filter(determinism != 0, Binaria > 0.5) %>%
select(-banda, -archivo, -sujeto, -sesion)
# Concatenamos
df <- bind_rows(df_10, df_5, df_0)
df$band <- band
return(df)
}
