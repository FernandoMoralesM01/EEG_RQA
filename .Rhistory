install.packages(ggpubr)
install.packages("ggpubr")
install.packages("rstatix")
# Violin plots con pruebas estadísticas
plot_violin <- function(data, col = "recurrence_rate") {
# ANOVA o Kruskal-Wallis según normalidad (ejemplo aquí: Kruskal)
stat_test <- data %>%
group_by(band) %>%
kruskal_test(as.formula(paste(col, "~ condicion"))) %>%
adjust_pvalue(method = "bonferroni") %>%
add_significance()
# Comparaciones post-hoc
pairwise_test <- data %>%
group_by(band) %>%
pairwise_wilcox_test(as.formula(paste(col, "~ condicion")),
p.adjust.method = "bonferroni")
# Gráfico
p <- ggplot(data, aes(x = condicion, y = .data[[col]], fill = condicion)) +
geom_violin(trim = FALSE, alpha = 0.6) +
geom_boxplot(width = 0.1, outlier.shape = NA, alpha = 0.5) +
facet_wrap(~ band, scales = "free") +
theme_minimal(base_size = 14) +
labs(y = col, x = "Condición") +
scale_fill_brewer(palette = "Set2")
# Agregar anotaciones de significancia
p <- p + stat_pvalue_manual(pairwise_test, label = "p.adj.signif",
y.position = max(data[[col]], na.rm = TRUE) * 1.1,
tip.length = 0.01)
return(list(plot = p, stat_test = stat_test, pairwise = pairwise_test))
}
